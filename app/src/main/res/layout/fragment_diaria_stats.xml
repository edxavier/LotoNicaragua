<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="@dimen/dimen_8_dp"
            style="@style/TextAppearance.AppCompat.Caption"
            android:text="Estos datos son meramente informativos y no representan ninguna predicción, recuerde que loto es un juego de azar"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/total"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ProgressBar
            android:indeterminate="true"
            android:id="@+id/progressBar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_marginTop="@dimen/dimen_8_dp"
            style="@style/AppTheme.TitleText"
            android:text="Frecuencia de números ganadores por rango"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.github.mikephil.charting.charts.BarChart
            android:layout_marginTop="8dp"
            android:id="@+id/histogram"
            android:layout_width="match_parent"
            android:layout_height="210dp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/native_ad_compose_view"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginTop="@dimen/dimen_8_dp"
            style="@style/AppTheme.TitleText"
            android:text="Los números más premiados"
            android:textAlignment="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.github.mikephil.charting.charts.BarChart
            android:layout_marginTop="8dp"
            android:id="@+id/histogram2"
            android:layout_width="match_parent"
            android:layout_height="210dp" />
    </LinearLayout>

</ScrollView>